{
  "name": "reshis-avia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/src/index.ts",
    "check": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "check:data": "tsx scripts/check-data.ts",
    "build": "npm run check && npm run check:data && vite build && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "^1.12.0"
    }
  }
}
